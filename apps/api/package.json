{
	"name": "api",
	"version": "1.0.0",
	"description": "",
	"main": "server.js",
	"scripts": {
		"dev": "./scripts/dev.sh",
		"dev:manual": "tsx watch --env-file=.env.development src/server.ts",
		"dev:prod": "tsx watch --env-file=.env.production src/server.ts",
		"setup": "./scripts/setup-dev.sh",
		"start": "node dist/server.js",
		"start:prod": "NODE_ENV=production node dist/server.js",
		"build": "tsc --build",
		"build:clean": "rm -rf dist && tsc --build",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"format:check": "biome format",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "./scripts/migrate.sh",
		"db:migrate:prod": "NODE_ENV=production drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --env-file=.env.development src/db/seed.ts",
		"db:seed:prod": "tsx --env-file=.env.production src/db/seed.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.18.1",
	"devDependencies": {
		"@biomejs/biome": "2.3.1",
		"@types/node": "^24.9.1",
		"@types/pg": "^8.15.5",
		"drizzle-kit": "^0.31.5",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.20.6",
		"typescript": "~5.9.3"
	},
	"dependencies": {
		"@ai-sdk/google": "^2.0.42",
		"@faker-js/faker": "^10.1.0",
		"@fastify/cors": "^11.1.0",
		"@fastify/swagger": "^9.5.2",
		"@scalar/fastify-api-reference": "^1.38.1",
		"ai": "^5.0.100",
		"drizzle-orm": "^0.44.7",
		"drizzle-zod": "^0.8.3",
		"fastify": "^5.6.1",
		"fastify-type-provider-zod": "^6.1.0",
		"pg": "^8.16.3",
		"uuidv7": "^1.0.2",
		"zod": "^4.1.12"
	}
}
