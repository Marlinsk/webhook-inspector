{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"rootDir": "./src",
		"baseUrl": ".",
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
