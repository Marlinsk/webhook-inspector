{
  "name": "webhook-inspect",
  "version": "1.0.0",
  "description": "Webhook Inspector - Uma aplicação monorepo para capturar e inspecionar requisições de webhook.",
  "private": true,
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "db:generate": "turbo db:generate --filter=api",
    "db:migrate": "turbo db:migrate --filter=api",
    "db:studio": "turbo db:studio --filter=api",
    "db:seed": "turbo db:seed --filter=api"
  },
  "keywords": [
    "webhook",
    "inspector",
    "monorepo",
    "turborepo"
  ],
  "devDependencies": {
    "turbo": "^2.6.3"
  }
}
